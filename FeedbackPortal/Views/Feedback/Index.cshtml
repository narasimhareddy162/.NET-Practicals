@model List<FeedbackPortal.Models.Feedback>
@{
    ViewData["Title"] = "All Feedback";
}

<h2>All Feedback</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No feedback yet. @Html.ActionLink("Be the first to submit!", "Create")</p>
}
else
{
    foreach (var item in Model)
    {
        @await Html.PartialAsync("_FeedbackCard", item)
    }
}